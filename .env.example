# Server Configuration
PORT=4000
NODE_ENV=development

# Authentication & Security
# Secret used for signing/verifying application JWT tokens in non-production or hybrid mode
JWT_SECRET=parakh_dev_jwt_secret_key_change_in_production_min32chars

# Supabase Auth & PostgreSQL Row-Level Security
# Replace with your Supabase Project configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Web Client Environment (Copy to web/.env if running separate dev server)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# AI Models (Groq Llama 3.3 70B Versatile)
GROQ_API_KEY=your_groq_api_key_here

# SQLite Database (Local Fallback & Testing)
DATABASE_URL=./parakh.db
